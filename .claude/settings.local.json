{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(ls:*)",
      "Bash(xargs grep:*)",
      "Bash(npx tsc:*)",
      "Bash(npm view:*)",
      "Bash(npm info:*)",
      "Bash(npm run:*)",
      "Bash(pnpm exec:*)",
      "Bash(npm test:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "devdigest"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if echo \"$TOOL_INPUT\" | grep -q \"git commit\"; then echo \"[pr-self-review] Commit detected — invoke /pr-self-review to review the diff.\"; fi'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/log-agent.js"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "devdigest": {
      "command": "node",
      "args": [
        "./mcp-server/dist/index.js"
      ],
      "env": {
        "DEVDIGEST_API_URL": "http://localhost:3001"
      }
    }
  }
}
